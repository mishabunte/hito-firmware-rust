import { Router } from "Router.slint";
import { ScreenEnum } from "ScreenEnum.slint";
import { Palette } from "Palette.slint";
import { SignedState } from "SignedScreen.slint";
import { TransparentButton } from "TransparentButton.slint";

export global SendStellarState {
    callback error-occurred();
    in-out property <string> amount;               // "12.345"
    in-out property <string> asset-code;           // "XLM"
    in-out property <string> destination-short;    // "GABCD…WXYZ"
    in-out property <string> memo-summary;         // 'text "Invoice #42"' or "None"

    // Details properties (bind from Rust)
    in-out property <string> source-short;         // "GA123…WXYZ"
    in-out property <string> sequence;             // "1234567890123"
    in-out property <string> fee;                  // "0.0000001 XLM"
    in-out property <int>    op-count;             // 1, 2, 3…
    in-out property <string> asset-issuer-short;   // "GBRPY…IR3J" or "Native"
    in-out property <int> page-index;
    in-out property <string> network;
    error-occurred => {
      Router.navigate(ScreenEnum.Send);
    }
}

component SendStellarPage1 {
  in property <length> in-padding: 60px;
  top := Text {
      text: "You send:\n" + SendStellarState.amount + " " + SendStellarState.asset-code;
      font-size: 20px;
      horizontal-alignment: center;
  }
  Text {
    y: top.y + in-padding;
      text: "To:\n" + SendStellarState.destination-short;
      font-size: 20px;
      horizontal-alignment: center;
  }
  Text {
    y: top.y + 2 * in-padding;
      text: "On " + SendStellarState.network;
      font-size: 15px;
      horizontal-alignment: center;
  }
}

component SendStellarPage2 {
  top:=Text { 
    text: "Source account:\n" + SendStellarState.source-short; 
    font-size: 15px; 
    x: 20px;
    y: 50px;
  }
  Text { 
    text: "Sequence:\n" + SendStellarState.sequence; 
    font-size: 15px;
    x: top.x;
    y: top.y + 50px; 
  }
  Text { 
    text: "Fee:\n" + SendStellarState.fee + " XLM";
    font-size: 15px; 
    x: top.x;
    y: top.y + 100px;
  }
  Text {
    x: top.x + 160px;
    y: top.y; 
    text: "Operations:\n" + SendStellarState.op-count + " op(s)"; 
    font-size: 15px; 
  }
  Text { 
    x: top.x + 160px;
    y: top.y + 50px;
    text: "Asset issuer:\n" + SendStellarState.asset-issuer-short; 
    font-size: 15px; 
  }
  TransparentButton {
    x: top.x + 185px;
    y: top.y + 92px;
    width: 50px;
    height: 50px;
    text-color-pressed: Palette.black;
    text-color-unpressed: Palette.blue;
    content: "Memo\n";
    in-font-size: 18px;
    clicked => {
      SendStellarState.page-index = 2;
    }
  }
}

export component SendStellarScreenView {
    width: 320px;
    height: 240px;

    // Page index: 0 = summary, 1 = details, 2 = memo

    // Callbacks
    callback reject-clicked;
    callback confirm-clicked;
    callback page-changed(page: int);
    // SUMMARY PAGE (SendStellarState.page-index == 0)
    init => {
        SendStellarState.page-index = 0;
    }
    SendStellarPage1 {
        y: -50px;
        width: root.width;
        height: root.height;
        visible: SendStellarState.page-index == 0;
    }
    SendStellarPage2 {
        width: root.width;
        height: root.height;
        visible: SendStellarState.page-index == 1;
    }
    Text {
      x: 20px;
      y: 45px; 
      text: "Memo:\n" + SendStellarState.memo-summary; 
      font-size: 20px; 
      wrap: word-wrap; 
      visible: SendStellarState.page-index == 2;
    }

    // Buttons row (bottom)
    TransparentButton {
      x: 40px;
      y: 200px;
        text-color-pressed: Palette.black;
        text-color-unpressed: Palette.blue;
        content: SendStellarState.page-index == 0 ? "DETAILS" : "BACK";
        clicked => {
            if SendStellarState.page-index == 0 {
                SendStellarState.page-index = 1;
                root.page-changed(SendStellarState.page-index);
            } else {
                SendStellarState.page-index = 0;
                root.page-changed(SendStellarState.page-index);
            }
            
        }
    }

    // Right button: CONFIRM (both pages)
    TransparentButton {
      x: 220px;
      y: 200px;
        text-color-pressed: Palette.black;
        text-color-unpressed: Palette.blue;
        content: "SIGN";
        clicked => {
            SignedState.request-data();
            Router.navigate(ScreenEnum.Signed);
        }
    }
}
