import { Router } from "Router.slint";
import { ScreenEnum } from "ScreenEnum.slint";
import { Palette } from "Palette.slint";
import { TransparentButton } from "TransparentButton.slint";

export global EnterPinState {
  in-out property <int> decoding-progress: -1; // -1 means no progress
  in-out property <bool> wrong-passcode;
  callback append-char(digit: int);
  callback remove-char();
  callback passcode-entered();
  callback unlock(result: bool);
  callback progress-request();
  callback set-progress(progress: int);
  callback reset();
  unlock(result) => {
      if !result {
          wrong-passcode = true;
      } else if Router.previous == ScreenEnum.Lock {
          Router.navigate(ScreenEnum.Home);
      } else if Router.previous == ScreenEnum.Settings{
          Router.navigate(ScreenEnum.ShowSeed);
      }
      reset();
  }
  set-progress(progress) => {
      debug("Setting decoding progress to", progress);
      decoding-progress = progress;
  }
  reset() => {
      decoding-progress = -1;
      wrong-passcode = false;
  }
}

component PassChar {
    in-out property <bool> pressed: false;
    in-out property <string> content: "0";
    in-out property <length> in-font-size: 20px;
    in-out property <bool> border-shown: true;
    in-out property <color> text-color-unpressed: Palette.black;
    in-out property <color> text-color-pressed: Palette.blue;
    mainText:= Text {
        text: content;
        font-size: root.in-font-size;
        color: pressed ? text-color-pressed : text-color-unpressed;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: parent.width * 3;
        height: parent.height * 1.7;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                pressed = true;
            } else if (event.kind == PointerEventKind.up) {
                pressed = false;
                root.clicked();
                debug("Clicked pin", content);
            }
        }
    }
    Text {
        text: content;
        y: mainText.y - root.in-font-size - 10px;
        font-size: root.in-font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: pressed;
    }
    callback clicked();
}

component ProgressBar {
    in-out property <int> progress; // -1 means no progress
    in-out property <bool> in-progress: progress > 0 && progress < 100;

    Rectangle {
        width: 150px;
        height: 10px;
        border-color: Palette.black;
        border-width: 2px;
        border-radius: 10px;
        background: Palette.grey;
        Rectangle {
            width: (parent.width - parent.border-width) * progress / 100;
            height: parent.height - 4px;
            x: 2px;
            y: 2px;
            background: EnterPinState.wrong-passcode ? Palette.red : Palette.black;
            border-radius: 8px;
        }
        visible: progress != -1;
    }
    Timer {
        interval: 2000ms;
        running: EnterPinState.wrong-passcode;
        triggered => {
            progress = -1;
            EnterPinState.set-progress(-1);
        }
    }
}

component PinGrid {
    property <length> spacing: 50px;
    VerticalLayout {
        spacing: 35px;
        alignment: center;
        HorizontalLayout {
            spacing: spacing;
            PassChar {content: "1";
                clicked() => {
                    number-clicked(1);
                }
            }
            PassChar {content: "2";
                clicked() => {
                    number-clicked(2);
                }
            }
            PassChar {content: "3";
                clicked() => {
                    number-clicked(3);
                }
            }
            PassChar {content: "4";
                clicked() => {
                    number-clicked(4);
                }
            }
            PassChar {content: "5";
                clicked() => {
                    number-clicked(5);
                }
            }     
        }
        HorizontalLayout {
            spacing: spacing;
            PassChar {content: "6";
                clicked() => {
                    number-clicked(6);
                }
            }
            PassChar {content: "7";
                clicked() => {
                    number-clicked(7);
                }
            }
            PassChar {content: "8";
                clicked() => {
                    number-clicked(8);
                }
            }
            PassChar {content: "9";
                clicked() => {
                    number-clicked(9);
                }
            }
            PassChar {content: "0";
                clicked() => {
                    number-clicked(0);
                }
            }
        }
    }
    callback number-clicked(int);
}

component EraseButton {
    property <bool> pressed: false;
    in-out property <string> content: "<";
    callback clicked();
    Text {
        text: content;
        width: 30px;
        height: 30px;
        font-size: 20px;
        color: pressed ? #d3d3d3 : red;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    pressed = true;
                } else if (event.kind == PointerEventKind.up) {
                    pressed = false;
                    root.clicked();
                    debug("Clicked erase", content);
                }
            }
        }
    }
}

component EnteredPassword {
    in-out property <int> password-count: 0;
    callback reset();
    reset() => {
        password-count = 0;
    }

    // Center the password display on the screen
    Rectangle {
        width: 320px;
        height: 30px;
        x: 0px;
        y: 0px;
        
        // Display rectangles with proper spacing like C firmware
        if EnterPinState.decoding-progress == -1: Text {
            text: {
                password-count == 0 ? "" :
                password-count == 1 ? "*" :
                password-count == 2 ? "**" :
                password-count == 3 ? "***" :
                password-count == 4 ? "****" :
                password-count == 5 ? "*****" : 
                password-count == 6 ? "******" : "ERROR";
            }
            letter-spacing: 10px;
            font-size: 20px;
            color: Palette.black;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        if EnterPinState.decoding-progress != -1: ProgressBar {
            progress: EnterPinState.decoding-progress;
        }
        Rectangle {
            width: 100px;
            height: 3px;
            x: (parent.width - self.width) / 2;
            y: parent.height - 5px;
            background: Palette.black;
            visible: false; // Disabled for now
        }
    }
}

export component EnterPinScreenView {
    width: 320px;
    height: 240px;
    property <length> line-y: 60px;
    in-out property <int> entered-password-count: 0;
    // back-shown: false;
    // header-title: "ENTER PASSCODE";
    EraseButton {
        x: 250px;
        y: line-y;
        clicked() => {
            if (EnterPinState.wrong-passcode) {
                EnterPinState.wrong-passcode = false;
            }
            if (entered-password-count > 0) {
                entered-password-count = entered-password-count - 1;
                EnterPinState.remove-char();
            }
        }
        visible: entered-password-count > 0;
    }
    EnteredPassword {
        x: 0px;
        y: line-y;
        password-count: entered-password-count;
    }
    PinGrid {
        x: 27px;
        y: 127px;
        number-clicked(digit) => {
            if (EnterPinState.wrong-passcode) {
                EnterPinState.wrong-passcode = false;
            }
            if (entered-password-count < 6) {
                entered-password-count = entered-password-count + 1;
                EnterPinState.append-char(digit);
            }
            if (entered-password-count == 6) {
                EnterPinState.passcode-entered();
                entered-password-count = 0;
            }
        }
    }
}