import { Router } from "Router.slint";
import { ScreenEnum } from "ScreenEnum.slint";
import { Palette } from "Palette.slint";
import { TransparentButton } from "TransparentButton.slint";

export global EnterPinState {
  in-out property <int> decoding-progress: -1; // -1 means no progress
  in-out property <bool> wrong-passcode;
  in-out property <string> password-sequence;
  callback append-char(digit: string);
  callback remove-char();
  callback passcode-entered();
  callback unlock(result: bool);
  callback progress-request();
  callback set-progress(progress: int);
  callback reset();
  callback shuffle-password-sequence();
  pure callback get-char(index: int) -> string;
  unlock(result) => {
      if !result {
          wrong-passcode = true;
      } else if Router.previous == ScreenEnum.Lock {
          Router.navigate(ScreenEnum.Home);
      } else if Router.previous == ScreenEnum.Settings{
          Router.navigate(ScreenEnum.ShowSeed);
      }
      reset();
  }
  set-progress(progress) => {
      decoding-progress = progress;
  }
  reset() => {
      decoding-progress = -1;
      wrong-passcode = false;
  }
}

component PassChar {
    in-out property <bool> pressed: false;
    in-out property <string> content: "0";
    in-out property <length> in-font-size: 20px;
    in-out property <bool> border-shown: true;
    in-out property <color> text-color-unpressed: Palette.black;
    in-out property <color> text-color-pressed: Palette.blue;
    mainText:= Text {
        text: content;
        font-size: root.in-font-size;
        color: pressed ? text-color-pressed : text-color-unpressed;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        width: parent.width * 3;
        height: parent.height * 3;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                pressed = true;
            } else if (event.kind == PointerEventKind.up) {
                pressed = false;
                root.clicked();
            }
        }
    }
    Text {
        text: content;
        y: mainText.y - root.in-font-size - 10px;
        font-size: root.in-font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: pressed;
    }
    callback clicked();
}

component ProgressBar {
    in-out property <int> progress; // -1 means no progress
    in-out property <bool> in-progress: progress > 0 && progress < 100;

    Rectangle {
        width: 150px;
        height: 10px;
        border-color: Palette.black;
        border-width: 1px;
        border-radius: 10px;
        background: Palette.grey;
        Rectangle {
            width: (parent.width - parent.border-width) * progress / 100;
            height: parent.height - 2px;
            x: 0px;
            y: 1px;
            background: EnterPinState.wrong-passcode ? Palette.red : Palette.black;
            border-radius: 4px;
        }
        visible: progress != -1;
    }
    Timer {
        interval: 2000ms;
        running: EnterPinState.wrong-passcode;
        triggered => {
            progress = -1;
            EnterPinState.set-progress(-1);
        }
    }
}

component PinGrid {
    property <length> spacing: 65px;
    top := PassChar {content: EnterPinState.get-char(0);
        clicked() => {
            number-clicked(EnterPinState.get-char(0));
        }
    }
    PassChar {content: EnterPinState.get-char(1);
        x: top.x + spacing;
        clicked() => {
            number-clicked(EnterPinState.get-char(1));
        }
    }
    PassChar {content: EnterPinState.get-char(2);
        x: top.x + spacing * 2;
        clicked() => {
            number-clicked(EnterPinState.get-char(2));
        }
    }
    PassChar {content: EnterPinState.get-char(3);
        x: top.x + spacing * 3;
        clicked() => {
            number-clicked(EnterPinState.get-char(3));
        }
    }
    PassChar {content: EnterPinState.get-char(4);
        x: top.x + spacing * 4;
        clicked() => {
            number-clicked(EnterPinState.get-char(4));
        }
    }  
    PassChar {content: EnterPinState.get-char(5);
        y: top.y + spacing - 5px;
        x: top.x;
        clicked() => {
            number-clicked(EnterPinState.get-char(5));
        }
    }
    PassChar {content: EnterPinState.get-char(6);
        y: top.y + spacing - 5px;
        x: top.x + spacing;
        clicked() => {
            number-clicked(EnterPinState.get-char(6));
        }
    }
    PassChar {content: EnterPinState.get-char(7);
        y: top.y + spacing - 5px;
        x: top.x + spacing * 2;
        clicked() => {
            number-clicked(EnterPinState.get-char(7));
        }
    }
    PassChar {content: EnterPinState.get-char(8);
        y: top.y + spacing - 5px;
        x: top.x + spacing * 3;
        clicked() => {
            number-clicked(EnterPinState.get-char(8));
        }
    }
    PassChar {content: EnterPinState.get-char(9);
        y: top.y + spacing - 5px;
        x: top.x + spacing * 4;
        clicked() => {
            number-clicked(EnterPinState.get-char(9));
        }
    }
    callback number-clicked(string);
}

component EraseButton inherits TransparentButton {
    content: "<";
    width: 30px;
    height: 30px;
    in-font-size: 20px;
    text-color-pressed: Palette.black;
    text-color-unpressed: Palette.blue;
}

component EnteredPassword {
    in-out property <int> password-count: 0;
    callback reset();
    reset() => {
        password-count = 0;
    }

    // Center the password display on the screen
    Rectangle {
        width: 320px;
        height: 30px;
        x: 0px;
        y: 0px;
        
        // Display rectangles with proper spacing like C firmware
        if EnterPinState.decoding-progress == -1: Text {
            text: {
                password-count == 0 ? "" :
                password-count == 1 ? "*" :
                password-count == 2 ? "**" :
                password-count == 3 ? "***" :
                password-count == 4 ? "****" :
                password-count == 5 ? "*****" : 
                password-count == 6 ? "******" : "ERROR";
            }
            letter-spacing: 10px;
            font-size: 20px;
            color: Palette.black;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        if EnterPinState.decoding-progress != -1: ProgressBar {
            progress: EnterPinState.decoding-progress;
        }
        Rectangle {
            width: 100px;
            height: 3px;
            x: (parent.width - self.width) / 2;
            y: parent.height - 5px;
            background: Palette.black;
            visible: false; // Disabled for now
        }
    }
}

export component EnterPinScreenView {
    width: 320px;
    height: 240px;
    property <length> line-y: 60px;
    in-out property <int> entered-password-count: 0;
    init => {
        EnterPinState.shuffle-password-sequence();
    }
    // back-shown: false;
    // header-title: "ENTER PASSCODE";
    EraseButton {
        x: 250px;
        y: line-y;
        clicked() => {
            if (EnterPinState.wrong-passcode) {
                EnterPinState.wrong-passcode = false;
            }
            if (entered-password-count > 0) {
                entered-password-count = entered-password-count - 1;
                EnterPinState.remove-char();
            }
        }
        visible: entered-password-count > 0;
    }
    EnteredPassword {
        x: 0px;
        y: line-y;
        password-count: entered-password-count;
    }
    PinGrid {
        x: 30px;
        y: 140px;
        number-clicked(digit) => {
            if (EnterPinState.wrong-passcode) {
                EnterPinState.wrong-passcode = false;
            }
            if (entered-password-count < 6) {
                entered-password-count = entered-password-count + 1;
                EnterPinState.append-char(digit);
            }
            if (entered-password-count == 6) {
                EnterPinState.passcode-entered();
                entered-password-count = 0;
            }
        }
    }
}