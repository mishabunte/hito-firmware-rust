import { BrightnessLogo, BrightnessBar, BrightnessController } from "Brightness.slint";
import { BatteryController,  BatteryLevel } from "Battery.slint";
import { TransparentButton } from "TransparentButton.slint";
import { BaseButton } from "BaseButton.slint";
import { Palette } from "Palette.slint";
import { LockScreenView } from "LockScreen.slint";

import "../../../res/fonts/RobotoMono-Regular.ttf";

export { BrightnessController, BatteryController}

component ScreenBorders {
    width: 320px;
    height: 240px;
    // Screen corners
    // Top left 
    Rectangle {
        x: 0px;
        y: 0px;
        width: 2px;
        height: 2px;
        background: Palette.black;
    }
    Rectangle {
        x: 2px;
        y: 0px;
        width: 2px;
        height: 1px;
        background: Palette.black;
    }
    Rectangle {
        x: 0px;
        y: 2px;
        width: 1px;
        height: 2px;
        background: Palette.black;
    }
    // Top right
    Rectangle {
        x: 318px;
        y: 0px;
        width: 2px;
        height: 2px;
        background: Palette.black;
    }
    Rectangle {
        x: 316px;
        y: 0px;
        width: 2px;
        height: 1px;
        background: Palette.black;
    }
    Rectangle {
        x: 319px;
        y: 2px;
        width: 1px;
        height: 2px;
        background: Palette.black;
    }
    // Bottom right
    Rectangle {
        x: 318px;
        y: 238px;
        width: 2px;
        height: 2px;
        background: Palette.black;
    }
    Rectangle {
        x: 316px;
        y: 239px;
        width: 2px;
        height: 1px;
        background: Palette.black;
    }
    Rectangle {
        x: 319px;
        y: 236px;
        width: 1px;
        height: 2px;
        background: Palette.black;
    }
    // Bottom left
    Rectangle {
        x: 0px;
        y: 238px;
        width: 2px;
        height: 2px;
        background: Palette.black;
    }
    Rectangle {
        x: 0px;
        y: 239px;
        width: 3px;
        height: 1px;
        background: Palette.black;
    }
    Rectangle {
        x: 0px;
        y: 236px;
        width: 1px;
        height: 2px;
        background: Palette.black;
    }
}

enum Protocol {
    Bluetooth,
    NFC
}

component SettingsButtonLine inherits Rectangle {
  width: 27px;
  height: 2px;
  background: Palette.black;
  border-width: 0px;
}

export component SettingsButton {
    in-out property <bool> pressed: false;
    in-out property <string> content: "____";
    in-out property <color> text-color-unpressed: Palette.black;
    in-out property <color> text-color-pressed: Palette.blue;
    in-out property <length> letter-spacing: -2px;
    line1:=SettingsButtonLine {
      y: 5px;
      background: pressed ? Palette.blue : Palette.black;
    }
    line2:=SettingsButtonLine {
      y: 16px;
      background: pressed ? Palette.blue : Palette.black;
    }
    TouchArea {
        x: line1.x - 5px;
        y: line1.y - 5px;
        width: line2.width + 5px;
        height: line2.y + 5px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                pressed = true;
            } else if (event.kind == PointerEventKind.up) {
                pressed = false;
                root.clicked();
            }
        }
    }
    callback clicked();
}

export component BackButton {
    in-out property <bool> pressed: false;
    in-out property <string> content: "X";
    in-out property <length> in-font-size: 20px;
    in-out property <bool> border-shown: true;
    in-out property <color> text-color-unpressed: Palette.blue;
    in-out property <color> text-color-pressed: Palette.black;
    Text {
        text: content;
        font-size: root.in-font-size;
        color: pressed ? text-color-pressed : text-color-unpressed;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
            x: parent.x - 10px;
            y: parent.y - 10px;
            width: parent.width + 15px;
            height: parent.height + 15px;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    pressed = true;
                } else if (event.kind == PointerEventKind.up) {
                    pressed = false;
                    root.clicked();
                    //debug("Clicked pin", content);
                }
            }
        }
    }
    callback clicked();
}

export struct ScreenItem {
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
}

export struct ScreenButton {
    text: string,
    has-border: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    inverted: bool,
}

export struct ScreenImage {
    source: image,
    x: length,
    y: length,
    width: length,
    height: length,
}

export component MainWindow inherits Window {
    width: 320px;
    height: 240px;
    background: white;
    callback pressed(item: ScreenButton);
    callback press(item: ScreenButton);
    callback clear-screen();
    callback unlock-requested();
    callback go-back();

    in-out property <bool> setting-shown: true;
    in-out property <bool> back-shown: true;

    clear-screen => {
      header-title = "";
      items = [];
      images = [];
      buttons = [];
      setting-shown = false;
      back-shown = true;
      protocol-image-shown = false;
      subheader-title = "";
      current-protocol = Protocol.NFC;
      center-text = false;
    }

    ScreenBorders {}

    default-font-family: "Roboto Mono";

    in-out property <[ScreenItem]> items;
    in-out property <[ScreenImage]> images;
    in-out property <[ScreenButton]> buttons;

    in-out property <bool> protocol-image-shown: false;
    in-out property <Protocol> current-protocol: Protocol.NFC;

    in-out property <bool> center-text: false;

    in-out property <bool> is-lockscreen: false;
    
    for item in items: Rectangle {
      Text {
      x: item.x;
      y: item.y;
      width: item.width;
      height: item.height;
      text: item.text;
      font-size: 20px;
      horizontal-alignment: root.center-text ? center : left;
    }
  }

    in-out property <string> subheader-title;
    
    // Display logo when on Home screen
    Image {
      y: 70px;
      source: @image-url("../../../res/img/hito_logo.png");
      visible: setting-shown;
    }

    // Protocol image (NFC or Bluetooth)
    in property <image> image-src: current-protocol == Protocol.NFC ? @image-url("../../../res/img/nfc.png") : @image-url("../../../res/img/bt_logo.png");
    Image {
      source: image-src;
      horizontal-alignment: center;
      vertical-alignment: center;
      visible: protocol-image-shown;
    }

    for btn in buttons: Rectangle {
      x: btn.x;
      y: btn.y;
      width: btn.width;
      height: btn.height;
      if btn.has-border: BaseButton {
          button-height: parent.height;
          button-width: parent.width;
          content: btn.text;
          text-color-pressed: !btn.inverted ? Palette.black : Palette.blue;
          text-color-unpressed: !btn.inverted ? Palette.blue : Palette.black;
          border-color-pressed: !btn.inverted ? Palette.black : Palette.blue;
          border-color-unpressed: !btn.inverted ? Palette.blue : Palette.black;
          in-font-size: 20px;
          clicked() => {
              debug("Button clicked:", btn.text);
              root.pressed({
                  text: btn.text,
                  x: btn.x,
                  y: btn.y,
                  width: btn.width,
                  height: btn.height,
              });
          }
      }
      if !btn.has-border: TransparentButton {
          in-font-size: 20px;
          content: btn.text;
          text-color-pressed: !btn.inverted ? Palette.black : Palette.blue;
          text-color-unpressed: !btn.inverted ? Palette.blue : Palette.black;
          clicked() => {
              debug("Button clicked:", btn.text);
              root.pressed({
                  text: btn.text,
                  x: btn.x,
                  y: btn.y,
                  width: btn.width,
                  height: btn.height,
              });
          }
      }
    }

    settings:= SettingsButton {
        visible: setting-shown;
        x: 35px;
        y: 15px;
        clicked() => root.pressed({
            text: "SETTINGS",
            x: settings.x,
            y: settings.y,
            width: settings.width,
            height: settings.height,
        });
      }

    in-out property <string> header-title;
    property <length> top_bar_padding: 8px;

    Text {
        y: top_bar_padding;
        text: header-title;
        font-size: 20px;
        horizontal-alignment: center;
        wrap: word-wrap;
        visible: !BrightnessController.scale-shown;
    }

    Text {
      y: top_bar_padding + 27px;
      text: subheader-title;
      horizontal-alignment: center;
      wrap: word-wrap;
      visible: !BrightnessController.scale-shown;
      font-size: 12px;
    }

    HorizontalLayout {
      width: parent.width;
      spacing: 20px;
      alignment: space-between;
      padding-right: 9px;
      padding-left: 15px;
      padding-top: top_bar_padding + 2.4px;
      
      Rectangle {
        width: 20px;
        height: 22px;
        BackButton {
          clicked => {
            root.go-back();
          }
          visible: back-shown;
        }
      }

      // Layout container for positioning elements
      HorizontalLayout {
        height: 20px;
        spacing: 7px;
        alignment: end;
        // Brightness control in top-right corner
        brightness-logo := BrightnessLogo {
          visible: !BrightnessController.scale-shown;
        }
      
        Rectangle {
          width: 20px;
          height: 20px;
          battery-indicator := BatteryLevel {}
        }
      }
    }

    brightness-bar := BrightnessBar {
      x: parent.width / 2 - self.width / 2;
      y: is-lockscreen ? 185px : 20px;
      visible: BrightnessController.scale-shown;
    }

    // Global touch area to hide brightness scale when clicking outside - only active when scale is shown
    if BrightnessController.scale-shown: TouchArea {
        width: parent.width;
        height: parent.height;
        z: -1; // Above other elements to capture all clicks

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                // Check if click is outside brightness control area
                if (self.mouse-x < brightness-bar.x - 10px ||
                    self.mouse-x > brightness-bar.x + brightness-bar.width + 200px ||
                    self.mouse-y < brightness-bar.y - 10px ||
                    self.mouse-y > brightness-bar.y + brightness-bar.height + 10px) {
                    BrightnessController.scale-shown = false;
                    BrightnessController.scale-shown-changed();
                }
            }
        }
    }

    if is-lockscreen: LockScreenView {
      show-text: !BrightnessController.scale-shown;
      unlock-requested => {
        root.unlock-requested();
      }
    }
    callback battery-level-requested() -> int;
}