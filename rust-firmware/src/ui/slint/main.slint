import { BrightnessController } from "Brightness.slint";
import { BatteryController } from "Battery.slint";
import { LockScreenView } from "LockScreen.slint";
import { HomeScreenView } from "HomeScreen.slint";
import { EnterPinScreenView } from "EnterPinScreen.slint";
import { SignedScreenView } from "SignedScreen.slint";
import { SignedState } from "SignedScreen.slint";
import { TransparentButton } from "TransparentButton.slint";
import { SendScreenView } from "SendScreen.slint";
import { SettingsScreenView } from "SettingsScreen.slint";
import { EnterPinState } from "EnterPinScreen.slint";
import { PairWithTheAppScreenView } from "PairWithTheAppScreen.slint";
import { DeviceInfoScreenView } from "DeviceInfoScreen.slint";
import { DeviceInfoState } from "DeviceInfoScreen.slint";
import { ReceiveScreenView } from "ReceiveScreen.slint";
import { ReceiveDataState } from "ReceiveScreen.slint";
import { TestLatticeScreenView } from "TestLatticeScreen.slint";
import { TestLatticeDataState } from "TestLatticeScreen.slint";
import { ShowSeedScreenView } from "ShowSeedScreen.slint";
import { ShowSeedState } from "ShowSeedScreen.slint";
import { SendScreenState } from "SendScreen.slint";
import { Protocol } from "SendScreen.slint";
import { SendStellarScreenView } from "SendStellarScreen.slint";
import { SendStellarState } from "SendStellarScreen.slint";

import { Router } from "Router.slint";
import { ScreenEnum } from "ScreenEnum.slint";
export { Router, ScreenEnum } // Export Router for global access

export { StartScreen } from "SetStartScreen.slint";

export { BrightnessController, BatteryController, EnterPinState, DeviceInfoState, ReceiveDataState, SendScreenState, SendStellarState, ShowSeedState, SignedState, TestLatticeDataState } // Export controllers for global access
import "../../../res/fonts/RobotoMono-Regular.otf";
import { BrightnessLogo, BrightnessBar } from "Brightness.slint";
import { BatteryLevel } from "Battery.slint";
import { Palette } from "Palette.slint";

component HeaderBar {
    in-out property<string> header-title: "";
    header := Text {
        y: 10px;
        text: header-title;
        font-size: 20px;
        horizontal-alignment: center;
        wrap: word-wrap;
        visible: !BrightnessController.scale-shown;
    }
}

component BackButton inherits TransparentButton {
    content: "X";
    in-font-size: 20px;
    text-color-pressed: Palette.black;
    text-color-unpressed: Palette.blue;
    clicked() => {
        Router.back();
    }
}

export component MainWindow inherits Window {
    width: 320px;
    height: 240px;
    background: white;

    default-font-family: "Roboto Mono";

    in property <bool> is-lockscreen: {
        if (Router.current == ScreenEnum.Lock) {
            true;
        } else {
            false;
        }
    }
    in-out property <string> header-title: {
        if (Router.current == ScreenEnum.EnterPin) {
            "Enter Passcode";
        } else if (Router.current == ScreenEnum.Send) {
            "SEND CRYPTO";
        } else if (Router.current == ScreenEnum.PairWithTheApp) {
            "PAIR WITH THE APP";
        } else if (Router.current == ScreenEnum.DeviceInfo) {
            "DEVICE INFO";
        } else if (Router.current == ScreenEnum.ShowSeed) {
            "SEED, page " + (ShowSeedState.page-number + 1) + "/" + ShowSeedState.total-pages;
        } else if (Router.current == ScreenEnum.SendStellar) {
            "SEND STELLAR";
        } else if (Router.current == ScreenEnum.Signed) {
            "SCAN TRANSACTION";
        } else if (Router.current == ScreenEnum.Receive) {
            "YOUR ADDRESS";
        } else {
            "";
        }
    }
    in-out property <bool> back-shown: {
        if (Router.current == ScreenEnum.Lock || Router.current == ScreenEnum.Home || Router.current == ScreenEnum.EnterPin) {
            false;
        } else {
            true;
        }
    }

    // Internal brightness control state
    out property <bool> brightness-scale-shown: false;
    HeaderBar {
        y: 0px;
        header-title: header-title;
    }

    HorizontalLayout {
        width: parent.width;
        alignment: start;
        y: 10px;
        VerticalLayout {
            alignment: start;
            BackButton {
                x: 20px;
                visible: back-shown;
            }
        }
    }

    // Layout container for positioning elements
    HorizontalLayout {
        width: parent.width;
        spacing: 7px;
        padding-right: 9px;
        padding-top: 5px;
        alignment: end;
        // Brightness control in top-right corner
        brightness-logo := BrightnessLogo {
          width: 20px;
          height: 20px;
          visible: !BrightnessController.scale-shown;
        }
      
        Rectangle {
          width: 20px;
          height: 20px;
          battery-indicator := BatteryLevel {
            visible: !BrightnessController.scale-shown;
        }
      }
    }
    brightness-bar := BrightnessBar {
        x: brightness-logo.x - 105px;
        y: is-lockscreen ? brightness-logo.y + 175px : brightness-logo.y + 10px;
        visible: BrightnessController.scale-shown;
    }

    // Global touch area to hide brightness scale when clicking outside - only active when scale is shown
    if BrightnessController.scale-shown: TouchArea {
        width: parent.width;
        height: parent.height;
        z: -1; // Above other elements to capture all clicks

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                // Check if click is outside brightness control area
                if (self.mouse-x < brightness-bar.x - 10px ||
                    self.mouse-x > brightness-bar.x + brightness-bar.width + 200px ||
                    self.mouse-y < brightness-bar.y - 10px ||
                    self.mouse-y > brightness-bar.y + brightness-bar.height + 10px) {
                    BrightnessController.scale-shown = false;
                    BrightnessController.scale-shown-changed();
                }
            }
        }
    }
    callback battery-level-requested() -> int;
    Rectangle {
        if Router.current == ScreenEnum.Lock: LockScreenView {
            show-text: !BrightnessController.scale-shown;
        }
        if Router.current == ScreenEnum.EnterPin: EnterPinScreenView {}
        if Router.current == ScreenEnum.Home: HomeScreenView {}
        if Router.current == ScreenEnum.Send: SendScreenView {}
        if Router.current == ScreenEnum.Settings: SettingsScreenView {}
        if Router.current == ScreenEnum.PairWithTheApp: PairWithTheAppScreenView {}
        if Router.current == ScreenEnum.DeviceInfo: DeviceInfoScreenView {}
        if Router.current == ScreenEnum.Receive: ReceiveScreenView {}
        if Router.current == ScreenEnum.ShowSeed: ShowSeedScreenView {}
        if Router.current == ScreenEnum.SendStellar: SendStellarScreenView {}
        if Router.current == ScreenEnum.Signed: SignedScreenView {}
        if Router.current == ScreenEnum.TestLatticeScreen: TestLatticeScreenView {}
    }
}